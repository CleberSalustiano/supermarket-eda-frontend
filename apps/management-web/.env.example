# Build-time configuration for management-web. Copy to .env.production (git-ignored) and set real values.
# Production builds fail closed (configuration error screen) when a required variable is missing.
# Required in production:
FRONTEND_TENANT_ID=00000000-0000-4000-8000-000000000000
FRONTEND_CHECKOUT_API_BASE_URL=https://checkout.example.com
FRONTEND_MANAGEMENT_API_BASE_URL=https://management.example.com
# Optional in production (an invalid value is an error):
FRONTEND_DEFAULT_LOCALE=pt-BR
# Development only (ignored in production builds): show developer tools, true or false.
# FRONTEND_DEV_TOOLS=false
