{
  "name": "@supermarket/frontend-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Shared UI package for frontend applications.",
  "type": "module",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.2"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@supermarket/frontend-i18n": "0.1.0",
    "clsx": "2.1.1",
    "lucide-react": "0.525.0",
    "tailwind-merge": "3.3.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./design-tokens": "./src/design-tokens.ts",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./fonts": "./src/fonts.ts",
    "./tokens.json": "./src/theme/tokens.json",
    "./test": "./src/test/render-with-providers.tsx"
